# /etc/dials/dials.env (mode 0600, owner root:dials). Secrets live here, never in the database.
APP_ENV=prod
LISTEN_ADDR=127.0.0.1:8081
BASE_PATH=/free-direct-dials
PUBLIC_ORIGIN=https://markemindai.com
DATA_DIR=/var/lib/dials
BACKUP_DIR=/var/backups/dials
TMP_DIR=/var/lib/dials/tmp
LOG_LEVEL=warn

# 32+ random bytes: openssl rand -base64 48
SECRET_KEY=

# Superadmin: secret path (16-64 of A-Z a-z 0-9 _ -) and REQUIRED IP allow-list.
# openssl rand -hex 16 gives a good path. Comma-separated IPs or CIDRs, IPv4 or IPv6.
ADMIN_PATH=
ADMIN_ALLOW_CIDRS=
ADMIN_EMAIL=ops@markemindai.com

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → add site markemindai.com)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Email: providers in failover order with daily caps. Campaigns stop at (100 - reserve)% so
# sign-in codes always go through.
MAIL_PROVIDERS=brevo:300,resend:100
MAIL_FROM=no-reply@markemindai.com
MAIL_FROM_NAME=Free Direct Dials
MAIL_OTP_RESERVE_PCT=30
BREVO_API_KEY=
RESEND_API_KEY=
# SMTP (Amazon SES, Zoho, Postmark…): add smtp:5000 to MAIL_PROVIDERS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Bounce webhooks: https://markemindai.com/free-direct-dials/api/hooks/mail/brevo?k=<token>
MAIL_WEBHOOK_TOKEN=

# Optional self-hosted Reacher mailbox verifier
REACHER_URL=
REACHER_TOKEN=

# Optional: purge Cloudflare cache after imports/settings (token with Zone.Cache Purge only)
CF_API_TOKEN=
CF_ZONE_ID=

# Backups are AES-256-GCM encrypted when set. openssl rand -hex 32
# STORE A COPY OF THIS KEY OFF THE SERVER: without it, backups cannot be restored.
BACKUP_KEY=
